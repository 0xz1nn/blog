defaultView: "Posts"
filters:
  or:
    - file.ext == "md"
    - file.ext == "mdx"

properties:
  "file.fullname":
    displayName: Full File Name
  "file.name":
    displayName: Name
  "note.date":
    displayName: Date
  "note.description":
    displayName: Description
  "note.draft":
    displayName: Draft
  "note.image":
    displayName: Image
  "note.pubDate":
    displayName: PubDate
  "note.published":
    displayName: Published
  "note.tags":
    displayName: Tags
  "note.title":
    displayName: Title
  "note.updated":
    displayName: Updated

views:
  - type: cms
    name: "Posts"
    filters:
      and:
        - file.folder.startsWith("posts")
    sort:
      - property: updated
        direction: DESC
    imageFormat: "cover"
    showDate: true
    customizeNewButton: true
    newNoteLocation: "posts"
    fallbackToEmbeds: "if-empty"
    propertyDisplay1: file.fullname
    showTextPreview: true
    propertyLabels: "above"
    titleProperty: note.title
    dateProperty: note.updated
    descriptionProperty: note.description
    imageProperty: note.image
    showTags: true
    tagsProperty: note.tags
    showDraftStatus: true
    draftStatusProperty: note.draft
    draftStatusReverse: true
  - type: cms
    name: "Astro Blog"
    filters:
      and:
        - file.folder.startsWith("Astro Blog")
    sort:
      - property: updated
        direction: DESC
    imageFormat: "cover"
    showDate: true
    customizeNewButton: true
    newNoteLocation: "Astro Blog"
    fallbackToEmbeds: "if-empty"
    propertyDisplay1: file.fullname
    showTextPreview: true
    propertyLabels: "above"
    titleProperty: note.title
    dateProperty: note.updated
    descriptionProperty: note.description
    imageProperty: note.image
    showTags: true
    tagsProperty: note.tags
    showDraftStatus: true
    draftStatusProperty: note.draft
    draftStatusReverse: false
  - type: cms
    name: "Pages"
    filters:
      and:
        - file.folder.startsWith("spec")
    sort:
      - property: file.ctime
        direction: DESC
    imageFormat: "cover"
    showDate: true
    customizeNewButton: true
    newNoteLocation: "spec"
    fallbackToEmbeds: "if-empty"
    propertyDisplay1: file.fullname
    showTextPreview: true
    propertyLabels: "above"
    titleProperty: file.fullname
    titlePropertyNested: file.fullname
    dateProperty: file.ctime
    descriptionProperty: note.description
    imageProperty: note.image
    showTags: true
    tagsProperty: note.tags
    showDraftStatus: true
    draftStatusUseFilenamePrefix: true
  - type: cms
    name: "View"